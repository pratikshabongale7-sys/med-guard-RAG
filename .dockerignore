# Keep the image lean — exclude everything the serving app doesn't need at runtime.
.venv/
.git/
.github/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Eval/research artifacts — not needed to serve /ask
eval/
scripts/
tests/
*.md
FINDINGS.md
RESULTS_SUMMARY.md

# Local secrets & env — inject via container env/secrets instead
.env
.env.*

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# Model/HF caches (downloaded fresh in-container)
.cache/
